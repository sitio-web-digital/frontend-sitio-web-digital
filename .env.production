# Valores de build para producción (self-hosted + Cloudflare Tunnel). Nada
# sensible acá — son URLs públicas.
#
# Migrado el 2026-08-08: sitioweb.digital es dominio propio (ya no
# cloudfordeploy.com, la zona compartida con otros proyectos que se usaba
# antes de tener uno registrado). Mismos hostnames que
# infraestructura/terraform/variables.tf.
VITE_API_URL=https://api.sitioweb.digital/api
VITE_ROOT_DOMAIN=sitioweb.digital
# La app en sí vive en su propio subdominio fijo (no en el apex: ahí sigue
# el sitio viejo de DonWeb) — distinto de un subdominio de cliente más, ver
# App.jsx > detectPublicSubdomain.
VITE_APP_HOSTNAME=app.sitioweb.digital

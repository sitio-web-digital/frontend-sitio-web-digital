# Valores de build para el deploy de prueba en el runner (self-hosted +
# Cloudflare Tunnel). Nada sensible acá — son URLs públicas. Cuando
# sitiowebdigital.com.ar esté agregado como zona real en Cloudflare, cambiar
# estos valores (y borrar VITE_APP_HOSTNAME, ver src/utils/rootDomain.js) y
# volver a pushear a develop.
VITE_API_URL=https://api-dev.cloudfordeploy.com/api
# cloudfordeploy.com directo (no sitiowebdigital.cloudfordeploy.com): el
# certificado gratis de Cloudflare solo cubre un nivel de wildcard, así que
# los subdominios de cliente (<nombre>.cloudfordeploy.com) tienen que vivir
# directo bajo la zona compartida, no anidados un nivel más adentro.
VITE_ROOT_DOMAIN=cloudfordeploy.com
# La app en sí sigue en su propio hostname fijo, para no confundirse con un
# subdominio de cliente más (ver App.jsx > detectPublicSubdomain).
VITE_APP_HOSTNAME=sitiowebdigital.cloudfordeploy.com
